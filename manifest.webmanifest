{
  "id": "./",
  "name": "The Bear & Bean Games",
  "short_name": "Bear & Bean",
  "description": "The Bear & Bean Games: wholesome mini-games that work offline. Totally free, with no ads, no purchases, no tracking and no nonsense.",
  "lang": "en-GB",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#2b2018",
  "theme_color": "#0b0816",
  "icons": [
    {
      "src": "icons/icon-192.png?v=01a66771",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png?v=2701a8de",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png?v=f18c0bbd",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "games",
    "entertainment",
    "kids"
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "shortcuts": [
